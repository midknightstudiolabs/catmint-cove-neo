{
  "name": "catmint-cove-neo",
  "version": "3.4.7",
  "private": true,
  "description": "Catmint Cove — a cozy-idle cat sanctuary. Web game + Capacitor wrapper for the app stores. This repo (Neo) is the current build source.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-admob-consent.mjs",
    "build": "node scripts/build-www.mjs",
    "sync": "npm run build && cap sync",
    "sync:android": "npm run build && cap sync android",
    "sync:ios": "npm run build && cap sync ios",
    "add:android": "npm run build && cap add android",
    "add:ios": "npm run build && cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "serve": "node serve.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.1.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@revenuecat/purchases-capacitor": "^13.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1"
  }
}
